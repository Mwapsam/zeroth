{
  "name": "zeroth-backend",
  "version": "1.1.0",
  "description": "Zeroth Business Solutions Backend API",
  "main": "server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "indexes": "node scripts/createIndexes.js",
    "health": "node -e \"require('http').get('http://localhost:'+(process.env.PORT||5000)+'/api/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e.message);process.exit(1)})\"",
    "lint": "echo \"(add ESLint when ready)\" && exit 0",
    "postinstall": "node -e \"console.log('\\n📦 Zeroth backend deps installed. Next: npm run indexes && npm start\\n')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "uuid": "^9.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  },
  "keywords": [
    "zeroth",
    "zbs",
    "fintech",
    "agriculture",
    "brokerage",
    "marketplace"
  ]
}