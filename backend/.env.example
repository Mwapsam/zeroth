NODE_ENV=production
PORT=5000

# ---------- MongoDB ----------
# docker-compose overrides this to point at the bundled mongo service
MONGODB_URI=mongodb://localhost:27017/zeroth

# ---------- JWT ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d

# ---------- Frontend ----------
# Origin the browser loads the site from (CORS) and base URL for uploaded files
CLIENT_URL=http://localhost
PUBLIC_URL=http://localhost

# ---------- Admin ----------
ADMIN_ACCESS_KEY=replace-me

# ---------- SMTP (optional) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-specific-password
# SMTP_FROM="Zeroth Business Solutions <no-reply@zeroth.com>"
